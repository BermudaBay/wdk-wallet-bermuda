{
  "name": "@bermuda/wdk-wallet-evm-bermuda",
  "version": "0.3.2",
  "description": "Extends @tetherto/wdk-wallet-evm with Bermuda shielded accounts: private deposits, transfers and withdrawals for EVM wallets.",
  "keywords": [
    "wdk",
    "wallet",
    "bip-32",
    "ethereum",
    "evm",
    "bermuda",
    "privacy",
    "shielded"
  ],
  "author": "Bermuda",
  "license": "Apache-2.0",
  "repository": {
    "type": "git",
    "url": "git://github.com/bermudabay/wdk-wallet-evm-bermuda.git"
  },
  "main": "index.js",
  "type": "module",
  "types": "./types",
  "files": [
    "index.js",
    "bare.js",
    "bare/",
    "src/",
    "types/",
    "SECURITY.md"
  ],
  "engines": {
    "node": ">=20.19.0"
  },
  "devEngines": {
    "runtime": {
      "name": "node",
      "version": ">=22.0.0",
      "onFail": "error"
    }
  },
  "scripts": {
    "build:types": "tsc",
    "audit": "npm audit",
    "lint": "standard",
    "lint:fix": "standard --fix",
    "test": "NODE_NO_WARNINGS=1 cross-env NODE_OPTIONS=--experimental-vm-modules jest",
    "test:coverage": "NODE_NO_WARNINGS=1 cross-env NODE_OPTIONS=--experimental-vm-modules jest --coverage",
    "test:integration": "NODE_NO_WARNINGS=1 cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration",
    "test:integration:coverage": "NODE_NO_WARNINGS=1 cross-env NODE_OPTIONS=--experimental-vm-modules jest tests/integration --coverage",
    "test:bare": "node tests/bare/run.js"
  },
  "dependencies": {
    "@bermuda/sdk": "https://api.tilapialabs.xyz/bermuda/v0.3.2/sdk",
    "@noble/curves": "1.9.2",
    "@noble/hashes": "1.8.0",
    "@noble/secp256k1": "2.2.3",
    "bare-http1": "4.5.9",
    "bare-https": "3.0.0",
    "bare-node-runtime": "1.5.1",
    "bare-stream": "2.13.4",
    "bare-thread": "1.2.7",
    "bare-worker": "4.5.0",
    "bip39": "3.1.0",
    "ethers": "6.17.0",
    "sodium-universal": "5.0.1"
  },
  "peerDependencies": {
    "@tetherto/wdk-wallet": ">=1.0.0-beta.17 <2.0.0",
    "@tetherto/wdk-wallet-evm": ">=1.0.0-beta.17 <2.0.0"
  },
  "devDependencies": {
    "@nomicfoundation/hardhat-ethers": "4.0.15",
    "@tetherto/wdk-wallet": "1.0.0-beta.17",
    "@tetherto/wdk-wallet-evm": "1.0.0-beta.17",
    "bare": "1.34.0",
    "cross-env": "7.0.3",
    "hardhat": "3.14.0",
    "jest": "30.4.2",
    "standard": "17.1.2",
    "typescript": "5.8.3"
  },
  "overrides": {
    "js-yaml": "4.3.2",
    "undici": "7.29.1",
    "ws": "8.21.3"
  },
  "exports": {
    ".": {
      "types": "./types/index.d.ts",
      "bare": "./bare.js",
      "default": "./index.js"
    },
    "./bare/stream-promises": {
      "bare": "./bare/stream-promises.js"
    },
    "./bare/worker-threads": {
      "bare": "./bare/worker-threads.js"
    },
    "./package": {
      "default": "./package.json"
    }
  },
  "publishConfig": {
    "access": "public",
    "registry": "https://registry.npmjs.org/"
  },
  "standard": {
    "ignore": [
      "bare.js",
      "bare/entry.js",
      "tests/**/*.js"
    ]
  }
}
