# Show lifecycle script output inline instead of buffering it, so anything that
# does execute is visible in the log.
foreground-scripts=true

# Deliberately left at `false` (flipped from `true` in 098e322, "ce ghost 500").
# On npm >= 12 this is close to inert: the `allowScripts` policy is deny-by-default,
# so dependency install scripts are blocked and reported regardless. That policy --
# not this flag -- is what gates scripts now. Review the blocked list with
# `npm install-scripts ls`, and approve individually with `npm approve-scripts <pkg>`
# rather than turning this back on wholesale.
ignore-scripts=false

# Pin the *install* registry. package.json's publishConfig.registry only covers
# publishing; without this line a user-level ~/.npmrc or an npm_config_registry
# environment variable silently redirects the entire dependency tree.
registry=https://registry.npmjs.org/

# Every dependency in package.json is pinned to an exact version. Keep it that way
# when someone runs `npm i <pkg>`.
save-exact=true

# --------------------------------------------------------------------------
# npm >= 12 only. npm 11 warns about unknown keys and ignores them, which would
# leave these looking enforced locally while being a no-op in CI -- so the audit
# and test jobs in .github/workflows/build.yml pin npm 12 explicitly.
# --------------------------------------------------------------------------

# Only admit versions that have been public for a week. Compromised-maintainer
# publishes are typically yanked within hours, so that window is where the attack
# lives. The tree is fully version-pinned, so this only bites on deliberate
# updates; our own scope is exempt so first-party releases land immediately.
min-release-age=7
min-release-age-exclude[]=@bermuda/*

# `root` permits URL dependencies declared in this package.json -- @bermuda/sdk
# resolves to a tarball on api.tilapialabs.xyz -- while blocking any transitive
# dependency from introducing one. Note that a URL dependency is invisible to
# `npm audit`; the lockfile integrity hash is what pins its contents.
allow-remote=root

# npm 12's default, stated explicitly: no git dependencies.
allow-git=none
